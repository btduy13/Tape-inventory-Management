# Copy to .env.local and fill in. NEVER commit real secrets.
# ---- Public (shipped to the browser) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-start
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile test site key (always passes). Replace in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ---- Server only (never prefix with NEXT_PUBLIC_) --------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-start
# Cloudflare Turnstile test secret (always passes). Replace in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Leave empty locally to use the fake email sender.
RESEND_API_KEY=
EMAIL_FROM="Băng Keo <no-reply@your-domain.vn>"
# Comma-separated list notified of new leads / customer responses.
ADMIN_NOTIFY_EMAILS=owner@your-domain.vn
# Random string >= 16 chars used to hash client IPs.
IP_HASH_SALT=change-me-to-a-long-random-string
# Which proxy header carries the real client IP (rate limits). Leave empty on Vercel (auto).
# Self-hosted behind your own reverse proxy: x-real-ip | xff (rightmost X-Forwarded-For).
# Empty off Vercel = none: headers are ignored and all clients share one bucket.
TRUSTED_PROXY=
QUOTE_TOKEN_TTL_DAYS=14
