{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:security": "node node_modules/vitest/vitest.mjs run --config vitest.security.config.mts tests/security",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "db:start": "node node_modules/supabase/dist/supabase.js --workdir .. start",
    "db:reset": "node node_modules/supabase/dist/supabase.js --workdir .. db reset",
    "db:test": "node node_modules/supabase/dist/supabase.js --workdir .. test db",
    "db:types": "node node_modules/supabase/dist/supabase.js --workdir .. gen types typescript --local"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@react-pdf/renderer": "^4.9.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "isomorphic-dompurify": "^3.19.0",
    "konva": "^10.9.0",
    "next": "16.4.3",
    "nodemailer": "^10.5.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "^19.3.2",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "three": "^0.187.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
